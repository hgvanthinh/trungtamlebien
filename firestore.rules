rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: Kiểm tra xem user có phải admin không
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@thaybien.com';
    }

    // Helper function: Kiểm tra xem user đã đăng nhập chưa
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Kiểm tra xem user có phải là chủ sở hữu document không
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Collection: users
    match /users/{userId} {
      // Admin có thể đọc/ghi tất cả user documents
      allow read, write: if isAdmin();

      // User chỉ có thể đọc document của chính mình
      allow read: if isOwner(userId);

      // Học sinh có thể đọc thông tin các học sinh khác (cần cho leaderboard)
      // Chỉ cho phép đọc các field công khai: fullName, username, avatar, totalBehaviorPoints
      allow read: if isAuthenticated() && resource.data.role == 'student';

      // Cho phép tạo tài khoản mới (đăng ký)
      // User phải tạo document với uid trùng với auth uid
      // Chỉ cho phép tạo với role='student', classes=[] và approved=false (chờ admin duyệt)
      allow create: if isOwner(userId)
        && request.resource.data.role == 'student'
        && request.resource.data.classes == []
        && request.resource.data.approved == false
        && request.resource.data.keys().hasAll(['username', 'fullName', 'email', 'role', 'classes', 'approved']);

      // User có thể cập nhật một số field của chính mình (avatar, stats)
      // KHÔNG được đụng vào: role/email/classes/approved (định danh & phân quyền),
      // coins/gold (tiền — chỉ Cloud Function với Admin SDK mới được ghi),
      // smashAttempts (lượt đập heo — chỉ admin chốt tuần mới cấp).
      //
      // LƯU Ý BẢO MẬT: mọi thay đổi số dư PHẢI đi qua Cloud Function.
      // Không được thêm bất kỳ rule nào cho phép client ghi coins/gold —
      // kể cả rule "chỉ cho tăng", vì client tự chọn được giá trị tăng
      // và có thể tự đặt số dư tuỳ ý cho chính mình.
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['role', 'email', 'classes', 'approved', 'coins', 'gold', 'smashAttempts']);
    }

    // Cho phép admin query toàn bộ collection users (cần cho hybrid model và admin operations)
    match /users/{document=**} {
      allow read: if isAdmin();
    }

    // OPTIMIZED: Hạn chế students query toàn bộ users
    // Students chỉ query được với filter role='student' (leaderboard)
    // NOTE: Firestore rules không enforce query filters, nên cần validate ở client
    // Để bảo mật tốt hơn, nên tạo collection 'leaderboard' riêng (read-only)
    match /users/{document=**} {
      allow read: if isAuthenticated();
    }

    // Collection: leaderboard (read-only cache cho students)
    // TODO: Tạo Cloud Function scheduled để update collection này hàng ngày
    match /leaderboard/{leaderboardId} {
      allow read: if isAuthenticated();
      allow write: if false; // Chỉ Cloud Function mới write được
    }

    // Collection: classes
    match /classes/{classId} {
      // Admin có toàn quyền
      allow read, write: if isAdmin();

      // Học sinh chỉ có thể đọc lớp mà mình tham gia
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.students;
    }
    
    // Cho phép admin query toàn bộ collection classes (cần cho hybrid model)
    match /classes/{document=**} {
      allow read, write: if isAdmin();
    }

    // Collection: sessions (buổi học)
    match /sessions/{sessionId} {
      // Admin có toàn quyền
      allow read, write: if isAdmin();

      // Học sinh có thể xem session của lớp mình tham gia
      allow read: if isAuthenticated();
    }
    
    // Cho phép admin query toàn bộ collection sessions (cần cho hybrid model)
    match /sessions/{document=**} {
      allow read, write: if isAdmin();
    }

    // Collection: attendance (điểm danh)
    match /attendance/{attendanceId} {
      // Admin có toàn quyền
      allow read, write: if isAdmin();
    }
    
    // Cho phép admin query toàn bộ collection attendance
    match /attendance/{document=**} {
      allow read, write: if isAdmin();
    }

    // Collection: assignments (bài giao)
    match /assignments/{assignmentId} {
      // Admin có toàn quyền
      allow read, write: if isAdmin();
      
      // Học sinh chỉ được xem bài giao của lớp mình
      allow read: if isAuthenticated();
    }
    
    // Cho phép query toàn bộ collection assignments
    match /assignments/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Collection: videos (kho video)
    match /videos/{videoId} {
      // Admin có toàn quyền
      allow read, write: if isAdmin();

      // Học sinh chỉ được xem
      allow read: if isAuthenticated();
    }

    // Cho phép query toàn bộ collection videos
    match /videos/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Collection: exams (đề thi trong kho)
    match /exams/{examId} {
      // Admin có toàn quyền
      allow read, write: if isAdmin();

      // Học sinh chỉ được xem đề đã publish
      allow read: if isAuthenticated() && resource.data.isPublished == true;
    }

    // Cho phép query toàn bộ collection exams
    match /exams/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Collection: examSubmissions (bài làm của học sinh)
    match /examSubmissions/{submissionId} {
      // Admin có toàn quyền
      allow read, write: if isAdmin();

      // Học sinh chỉ được đọc/ghi submission của chính mình
      allow read, write: if isAuthenticated() && resource.data.studentUid == request.auth.uid;

      // Cho phép tạo submission mới
      allow create: if isAuthenticated() && request.resource.data.studentUid == request.auth.uid;
    }

    // Cho phép query examSubmissions
    match /examSubmissions/{document=**} {
      allow read: if isAdmin();
      // Students query submission của mình
      allow read: if isAuthenticated();
    }

    // Collection: settings (cài đặt hệ thống - background, etc.)
    match /settings/{settingId} {
      // Admin có toàn quyền
      allow read, write: if isAdmin();

      // Tất cả user được đọc settings (background image, etc.)
      allow read: if isAuthenticated();
    }

    // Collection: storeItems (món hàng trong Cửa Hàng)
    match /storeItems/{itemId} {
      // Admin có toàn quyền
      allow read, write: if isAdmin();

      // Học sinh được xem hàng để mua
      allow read: if isAuthenticated();
    }

    // Collection: storeCategories (loại hàng tùy chỉnh trong Cửa Hàng)
    match /storeCategories/{categoryId} {
      // Admin có toàn quyền
      allow read, write: if isAdmin();

      // Học sinh được xem để hiển thị nhãn loại hàng
      allow read: if isAuthenticated();
    }

    // Collection: inventories (kho đồ đã mua của học sinh)
    match /inventories/{inventoryId} {
      // Admin có toàn quyền
      allow read, write: if isAdmin();

      // Học sinh đọc/xóa đồ của chính mình.
      // KHÔNG cho tự tạo: việc mua hàng do Cloud Function purchaseItem xử lý,
      // nếu cho client create thì HS tự thêm đồ vào kho mà không mất tiền.
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ===== Game Nuôi Heo Đất =====

    // Collection: pigs (heo đất, docId = uid chủ heo → 1 heo / tài khoản)
    match /pigs/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      // KHÔNG cho HS tự tạo/xoá heo hay tự sửa XP:
      // - tạo heo  → Cloud Function pigPurchase (phải trả Đồng Vàng)
      // - cho ăn   → Cloud Function feedPig (cộng XP theo giờ server)
      // - nộp bài  → awardExamXp
      // - đập heo  → Cloud Function smashPiggy (xoá heo + trả vàng)
      //
      // Trước đây HS tự ghi được XP (+10 mỗi lần) nên có thể bơm cấp heo để
      // lọt top khối, và top khối được cấp lượt đập heo — tức là một đường
      // vòng để tạo ra Đồng Vàng.
      //
      // Chỉ còn cho phép đồng bộ lại khối lớp (grade) khi HS được xếp lớp mới.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['grade']);
    }

    // Collection: pigGameLogs (nhật ký game heo, append-only)
    match /pigGameLogs/{logId} {
      allow read, update, delete: if isAdmin();
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAdmin()
        || (isAuthenticated() && request.resource.data.uid == request.auth.uid);
    }

    // Collection: transfers (nhật ký chuyển xu/vàng giữa HS, append-only)
    // Việc chuyển khoản do Cloud Function transferCurrency thực hiện, và
    // chính nó ghi log này — client chỉ được ĐỌC giao dịch liên quan tới mình.
    match /transfers/{transferId} {
      allow read: if isAdmin();
      allow read: if isAuthenticated()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow write: if false;
    }

    // Collection: pigWeeklyResults (kết quả chốt tuần, docId = weekId)
    match /pigWeeklyResults/{weekId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ===== Game Đấu Trí 1v1 (Versus Game) =====
    // Collection: versusGames (bài đấu do admin tạo)
    match /versusGames/{gameId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      // HS được tăng matchesPlayed +1 khi trận kết thúc
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['matchesPlayed'])
        && request.resource.data.matchesPlayed == resource.data.get('matchesPlayed', 0) + 1;
    }

    // Collection: versusMatchResults (kết quả trận đấu, client ghi 1 lần)
    match /versusMatchResults/{resultId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Collection: versusRewardClaims (chốt mỗi trận chỉ nhận thưởng 1 lần)
    // Chỉ Cloud Function (Admin SDK) ghi được — client không đụng vào.
    match /versusRewardClaims/{sessionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Collection: craftLogs (nhật ký chế tạo vàng, phục vụ rà soát kinh tế)
    // Chỉ Cloud Function ghi; HS xem được log của chính mình.
    match /craftLogs/{logId} {
      allow read: if isAdmin();
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Collection: questionBank (kho câu hỏi dùng lại, chỉ admin quản lý)
    match /questionBank/{questionId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Mặc định: Chặn tất cả truy cập khác
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
